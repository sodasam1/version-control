# Version Control's settings for the shared installer (deploy/appkit.sh). Reference: kit/appkit/README.md in personal-site.
NAME=version-control
UNIXNAME=versioncontrol
TITLE="Version Control"
BASE_PATH=/version-control
PORT=8102
PKGS="py3-flask py3-waitress ffmpeg"
SVC_HOME=/var/empty
SRC_MARKER="app/wsgi.py app/versioncontrol/templates/owner.html"
HEALTH_PATH=/version-control/health
SITE_AUTH=1
# Program files stay on the boot disk; ALL data lives on the shared data volume (docs/STORAGE.md in personal-site), so a rebuilt server is simply pointed at it.
# The installer stops, before creating anything, if the volume is not mounted and holds a .volume-ok file; the service script (rc_pre) and the app
# (VERSIONCONTROL_REQUIRE_VOLUME) refuse to start without it. Keep data and backup on the SAME filesystem: backups hard-link the audio.
DATA_ROOT=/mnt/data
REQUIRE_MOUNT=$DATA_ROOT
DIRS="$DATA_ROOT/apps/version-control/data,@svc,@svc,751 $DATA_ROOT/apps/version-control/backup,@svc,@svc,755 $DATA_ROOT/apps/version-control/restore,@login,@svc,775"
CONF_LINES="VERSIONCONTROL_DATA_DIR=$DATA_ROOT/apps/version-control/data
VERSIONCONTROL_REQUIRE_VOLUME=1
VERSIONCONTROL_VOLUME_MARKER=$DATA_ROOT/.volume-ok
VERSIONCONTROL_BASE_PATH=/version-control
VERSIONCONTROL_STATIC_DIR=/usr/local/version-control/static
VERSIONCONTROL_BACKUP_DIR=$DATA_ROOT/apps/version-control/backup
VERSIONCONTROL_RESTORE_DIR=$DATA_ROOT/apps/version-control/restore
VERSIONCONTROL_OWNER_NAME=Owner"
